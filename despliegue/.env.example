# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores.
# NUNCA lo subas a git.

# ---------- Base de datos (contenedor MySQL) ----------
DB_USUARIO=usuario_pos
# SECRETO
DB_PASSWORD=cambiame
# SECRETO
DB_ROOT_PASSWORD=cambiame-root

# ---------- Seguridad ----------
# SECRETO - Llave para firmar los JWT del POS. Generala con: openssl rand -base64 48
APP_JWT_SECRET=cambiame-por-una-llave-aleatoria-larga
APP_JWT_EXPIRACION_MS=28800000
# SECRETO - Clave del administrador
ADMIN_CLAVE=cambiame

# ---------- Esquema ----------
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# ---------- Microservicio de asistencia ----------
# Por defecto apunta al puerto 8080 de esta misma PC
ASISTENCIA_API_URL=http://host.docker.internal:8080
# SECRETO
ASISTENCIA_API_TOKEN=cambiame
ASISTENCIA_SYNC_INTERVALO_MS=120000

# ---------- CORS ----------
# Ya acepta el front desde cualquier IP en los puertos 5175 y 5173
APP_CORS_ALLOWED_ORIGINS=http://*:5175,http://*:5173

TZ=America/Mexico_City
