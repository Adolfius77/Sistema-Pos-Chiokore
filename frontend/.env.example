# ============================================================================
# Plantilla de variables de entorno del FRONTEND (Vite + React)
#
# Copia este archivo como "frontend/.env" y reemplaza los valores.
#   cp frontend/.env.example frontend/.env
#
# El archivo .env real esta en .gitignore: NUNCA lo subas a git.
#
# AVISO: en Vite, todo lo que empiece con VITE_ se INCRUSTA en el bundle que
# se descarga el navegador. Es publico por definicion. Aqui no va ningun
# secreto: ni contrasenas, ni llaves de API, ni tokens.
# ============================================================================

# URL base del backend Spring Boot al que pega el POS (sin barra final).
VITE_API_BASE_URL=http://localhost:8082

# Nombre de la llave de localStorage donde se guarda el JWT de la sesion.
VITE_AUTH_TOKEN_KEY=token_pos_chiokore

# Nombre de la llave de localStorage donde se guarda el rol del usuario.
VITE_AUTH_ROLE_KEY=rol_pos_chiokore

# URL del sistema externo de asistencia al que se redirige para iniciar sesion.
VITE_URL_LOGIN_EXTERNO=http://localhost:5175/

# URL del sistema externo de asistencia al que se redirige al cerrar sesion.
VITE_URL_LOGOUT_EXTERNO=http://localhost:5175/
