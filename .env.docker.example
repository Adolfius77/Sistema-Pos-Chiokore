# ============================================================================
# Variables para "docker compose" (backend + MySQL).
#
# Copia este archivo como ".env" en la RAIZ del repositorio y llena los valores:
#   Windows (PowerShell):  Copy-Item .env.docker.example .env
#   Linux / macOS:         cp .env.docker.example .env
#
# docker compose lee el archivo .env automaticamente. Ese .env esta en
# .gitignore: NUNCA lo subas a git.
#
# Evita el signo $ en las contrasenas: docker compose lo interpreta como variable.
# ============================================================================

# ---------- Base de datos (MySQL dentro de Docker) ----------
# Usuario y contrasena que usara el backend para conectarse a MySQL.
DB_USUARIO=usuario_pos
# SECRETO
DB_PASSWORD=cambiame
# SECRETO - Contrasena del usuario root de MySQL dentro del contenedor.
DB_ROOT_PASSWORD=cambiame-root

# ---------- Seguridad del backend ----------
# SECRETO - Llave para firmar los JWT del POS. Larga y aleatoria; generala con:
#   openssl rand -base64 48
# o en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
APP_JWT_SECRET=cambiame-por-una-llave-aleatoria-larga
# SECRETO - Clave para entrar como administrador.
ADMIN_CLAVE=cambiame

# ---------- Microservicio de asistencia ----------
# Si el sistema de asistencia corre en tu PC (fuera de Docker) deja
# host.docker.internal; si corre en otra maquina pon su IP, ej. http://192.168.1.50:8080
ASISTENCIA_API_URL=http://host.docker.internal:8080
# SECRETO
ASISTENCIA_API_TOKEN=cambiame

# ---------- Opcionales ----------
# Zona horaria del contenedor (afecta la fecha y hora de cada venta).
TZ=America/Mexico_City
# Estrategia de esquema de Hibernate: update, validate, none.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
