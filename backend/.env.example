# ============================================================================
# Plantilla de variables de entorno del BACKEND (Spring Boot 4 / Java 21)
#
# Copia este archivo como "backend/.env" y reemplaza los valores.
#   cp backend/.env.example backend/.env
#
# El archivo .env real esta en .gitignore: NUNCA lo subas a git.
#
# OJO: Spring Boot NO lee archivos .env por si solo. Este archivo es la
# referencia de que variables existen; para que surtan efecto debes exportarlas
# al entorno del proceso. Opciones:
#   - Linux/macOS:  set -a && . ./backend/.env && set +a && ./mvnw spring-boot:run
#   - Docker:       docker run --env-file backend/.env ...
#   - systemd:      EnvironmentFile=/ruta/backend/.env en la unit
#   - PowerShell:   $env:SPRING_DATASOURCE_PASSWORD = "..."
#
# Cada variable tiene un valor por defecto en
# backend/src/main/resources/application.properties. Esos defaults son SOLO
# para desarrollo local; en produccion define TODAS las marcadas como SECRETO.
# ============================================================================

# ---------- Servidor ----------
# Puerto HTTP en el que escucha el backend.
SERVER_PORT=8082

# ---------- Base de datos ----------
# Cadena JDBC completa de la base MySQL de ventas (host, puerto y nombre).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/VentasDB?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# Usuario de MySQL con permisos sobre la base de ventas.
SPRING_DATASOURCE_USERNAME=usuario_pos

# SECRETO - Contrasena de ese usuario de MySQL. NUNCA debe ir a git.
SPRING_DATASOURCE_PASSWORD=cambiame

# ---------- Docker Compose (solo para docker-compose.yml) ----------
# Usuario y contrasena que se crean en el contenedor de MySQL. El backend en
# Docker usa estos mismos valores, no los SPRING_DATASOURCE_* de arriba.
DB_USUARIO=usuario_pos
# SECRETO - Contrasena del usuario de MySQL en Docker. NUNCA debe ir a git.
DB_PASSWORD=cambiame
# SECRETO - Contrasena de root del contenedor de MySQL. NUNCA debe ir a git.
DB_ROOT_PASSWORD=cambiame-root

# Estrategia de esquema de Hibernate: update, validate, none.
# En produccion usa "validate" o "none" para que la app no altere tablas sola.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Imprime cada consulta SQL en el log. Dejar en false salvo para depurar.
SPRING_JPA_SHOW_SQL=false

# ---------- Archivos subidos ----------
# Carpeta donde se guardan las imagenes de productos que sube el POS.
# Usa ruta ABSOLUTA. Una ruta relativa se resuelve contra el directorio desde el
# que se lanza el backend, asi que apunta a carpetas distintas segun si arrancas
# desde la raiz del repo o desde backend, y las fotos quedan rotas.
# Si la dejas vacia, scripts/dev-local.ps1 usa <raiz del repo>/uploads.
APP_UPLOAD_DIR=

# ---------- Seguridad ----------
# SECRETO - Llave con la que el POS firma y valida SUS PROPIOS tokens JWT.
# Debe ser larga y aleatoria, y DISTINTA de ASISTENCIA_API_TOKEN: si fueran la
# misma, quien conozca el token de asistencia podria fabricarse un token de
# ADMINISTRADOR de este sistema. Generala con: openssl rand -base64 48
# NUNCA debe ir a git. Al rotarla se invalidan todas las sesiones abiertas.
APP_JWT_SECRET=cambiame-por-una-llave-aleatoria-larga

# Vigencia del token de sesion en milisegundos (28800000 = 8 horas).
APP_JWT_EXPIRACION_MS=28800000

# SECRETO - Clave de acceso para entrar como administrador. NUNCA debe ir a git.
ADMIN_CLAVE=cambiame

# Origenes permitidos para CORS, separados por coma. Admite comodines porque el
# POS se abre desde tablets y telefonos con IP variable en la red local.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://192.168.*.*:5173,http://192.168.*.*:5175

# ---------- Microservicio de asistencia ----------
# URL base del microservicio externo de asistencia/nomina.
ASISTENCIA_API_URL=http://localhost:8080

# SECRETO - Token para LLAMAR a la API de asistencia (credencial de salida, no
# llave de firma). NUNCA debe ir a git. El valor anterior quedo publicado en el
# historial de commits: rotalo en el sistema de asistencia.
ASISTENCIA_API_TOKEN=cambiame

# Cada cuantos milisegundos se sincronizan los usuarios (120000 = 2 minutos).
ASISTENCIA_SYNC_INTERVALO_MS=120000

# ---------- Frontend (solo docker compose) ----------
# Se incrustan en el bundle al construir la imagen del front: son PUBLICAS y
# cambiarlas exige "docker compose build frontend". Para usar el POS desde la
# tablet pon la IP LAN de esta PC en vez de localhost.
VITE_API_BASE_URL=http://localhost:8082
VITE_URL_LOGIN_EXTERNO=http://localhost:5175/
VITE_URL_LOGOUT_EXTERNO=http://localhost:5175/
